// Orbit v2 schema — Solo mode
//
// Domain model centres on a single traveller moving through four missions.
// A mission is a guided set of questions. Each answer is versioned and
// snapshots the emission factor in effect at the time of the answer so
// historical signal scores remain stable even as factors are updated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Traveller (v2: single-user demo; multi-user is v3)
// ────────────────────────────────────────────────────────────────────────────

model Traveller {
  id        String   @id @default(cuid())
  handle    String   @unique
  name      String
  mode      String   @default("SOLO") // SOLO | HOUSEHOLD | CLASSROOM (future)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missions  MissionState[]
  answers   MissionAnswer[]
  logs      LogEntry[]
  snapshots SignalSnapshot[]
}

// ────────────────────────────────────────────────────────────────────────────
// Missions
//
// MissionKey is stored as a string because SQLite enum support is limited and
// we want to add missions later without a migration. Valid values are managed
// in lib/orbit/missions.ts.
// ────────────────────────────────────────────────────────────────────────────

model MissionState {
  id          String    @id @default(cuid())
  travellerId String
  traveller   Traveller @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  key         String // HOME_BASELINE | FLIGHT_QUESTION | FOOD_CHOICES | DIGITAL_CARBON
  status      String    @default("LOCKED") // LOCKED | ACTIVE | PARTIAL | LIT
  progress    Int       @default(0) // 0–100
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([travellerId, key])
  @@index([travellerId, status])
}

model MissionAnswer {
  id             String    @id @default(cuid())
  travellerId    String
  traveller      Traveller @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  missionKey     String // Must match a MissionState.key for this traveller
  questionKey    String // Unique per mission — e.g. "home.sqm", "flight.longhaul_count"
  valueNum       Float?
  valueStr       String?
  valueBool      Boolean?
  factorSnapshot Json? // Factor values captured at time of answer for reproducibility
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([travellerId, missionKey, questionKey])
  @@index([travellerId, missionKey])
}

// ────────────────────────────────────────────────────────────────────────────
// Signal — the 0–100 score with weekly snapshots for the trajectory graph
// ────────────────────────────────────────────────────────────────────────────

model SignalSnapshot {
  id            String    @id @default(cuid())
  travellerId   String
  traveller     Traveller @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  year          Int
  weekOfYear    Int // ISO week
  score         Int // 0–100
  trajectory    String // STEADY | DRIFTING | CLIMBING | SETTLING
  monthlyTCO2e  Float // Current best estimate in tonnes/month
  breakdown     Json // { home: 0.9, flights: 1.2, food: 0.5, digital: 0.2 }
  missionsLit   Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([travellerId, year, weekOfYear])
  @@index([travellerId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Observation log — the ship's log
// ────────────────────────────────────────────────────────────────────────────

model LogEntry {
  id          String    @id @default(cuid())
  travellerId String
  traveller   Traveller @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  kind        String // MISSION_PROGRESS | QUICK_LOG | SYSTEM | INSIGHT
  title       String
  body        String
  valueLabel  String? // e.g. "+8 SIGNAL", "MISSION 01 LIT"
  missionKey  String? // Optional link back to a mission
  occurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([travellerId, occurredAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Emission factors — versioned for reproducibility
//
// Unlike v1 this is not scoped to an organisation. It's a global reference
// table the signal calculation draws from. Each factor has a category key
// matched against the category emitted by a MissionAnswer.
// ────────────────────────────────────────────────────────────────────────────

model EmissionFactor {
  id            String   @id @default(cuid())
  category      String // HOME_ELECTRICITY | HOME_GAS | FLIGHT_SHORT | ... see lib/orbit/factors.ts
  label         String
  unit          String // e.g. "kWh", "km", "meal", "GB"
  factor        Float // kgCO2e per unit
  version       Int      @default(1)
  effectiveDate DateTime @default(now())
  isCurrent     Boolean  @default(true)
  source        String? // e.g. "UK DEFRA 2024", "IPCC AR6 WG3"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([category, version])
  @@index([category, isCurrent])
}

// ────────────────────────────────────────────────────────────────────────────
// Email capture — lead magnet sign-ups for the weekly Orbit digest.
//
// Not tied to a Traveller in v2 because Orbit is public and anonymous until
// someone opts in. We keep a light snapshot of their current signal so the
// first digest can say "you started at X" without another lookup. Sync state
// tracks delivery to Notion (the current destination) so we can retry or
// swap destinations later without losing the queue.
// ────────────────────────────────────────────────────────────────────────────

model EmailCapture {
  id             String    @id @default(cuid())
  email          String
  source         String    @default("orbit_perspective") // where on the page it came from
  travellerId    String? // optional link if we have one in session
  signalAtCapture Int? // snapshot of their signal score at sign-up
  monthlyTCO2e   Float? // snapshot of monthly tonnes at sign-up
  consent        Boolean   @default(true) // explicit opt-in checkbox state
  syncStatus     String    @default("PENDING") // PENDING | SYNCED | FAILED | SKIPPED
  syncedAt       DateTime?
  syncError      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([syncStatus, createdAt])
}
