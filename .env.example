DATABASE_URL="file:./dev.db"
# Leave false locally. Netlify uses a read-only demo mode via netlify.toml.
NEXT_PUBLIC_READ_ONLY_DEMO="false"

# Email capture — weekly Orbit digest sign-ups.
# If both are set, /api/capture writes each sign-up to a Notion database
# via the official REST API. If either is missing, capture still writes
# to the local DB but the row is marked SKIPPED (nothing is lost).
# Token is a Notion internal integration secret with insert access to the
# target database. Database ID is the 32-char id in the database URL.
NOTION_CAPTURE_TOKEN=""
NOTION_CAPTURE_DATABASE_ID=""
